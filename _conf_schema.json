{
  "enabled": {
    "description": "启用路由 Provider",
    "type": "bool",
    "default": true
  },
  "provider_id": {
    "description": "在 AstrBot 中显示的 Provider ID",
    "type": "string",
    "default": "multi_api_router",
    "hint": "其他插件选择模型时填写这个 ID。修改后需要重载插件或重启 AstrBot。"
  },
  "request_timeout_seconds": {
    "description": "每个上游的请求超时（秒）",
    "type": "int",
    "default": 45,
    "slider": {
      "min": 5,
      "max": 180,
      "step": 5
    }
  },
  "route_timeout_seconds": {
    "description": "自动路由总超时限制（秒）",
    "type": "int",
    "default": 90,
    "slider": {
      "min": 5,
      "max": 600,
      "step": 5
    },
    "hint": "覆盖并发排队、逐个上游尝试和主模型回退；达到总时限后停止后续调用。指定单个上游时仍使用单上游请求超时。"
  },
  "max_attempts": {
    "description": "单次请求最多尝试几个上游",
    "type": "int",
    "default": 3,
    "slider": {
      "min": 1,
      "max": 5,
      "step": 1
    },
    "hint": "每个上游只请求一次；此值限制最坏情况下的调用次数。"
  },
  "failure_threshold": {
    "description": "连续失败多少次后熔断",
    "type": "int",
    "default": 2,
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    }
  },
  "cooldown_seconds": {
    "description": "熔断冷却时间（秒）",
    "type": "int",
    "default": 300,
    "slider": {
      "min": 30,
      "max": 3600,
      "step": 30
    }
  },
  "max_concurrency": {
    "description": "路由器最大并发请求数",
    "type": "int",
    "default": 4,
    "slider": {
      "min": 1,
      "max": 32,
      "step": 1
    }
  },
  "max_input_chars": {
    "description": "单次请求最大输入字符数",
    "type": "int",
    "default": 262144,
    "hint": "默认 262144（256 Ki 字符）。超出后直接拒绝，不调用任何上游。字符数是跨模型通用预算。"
  },
  "max_output_tokens": {
    "description": "单次请求最大输出 Token",
    "type": "int",
    "default": 2048,
    "hint": "调用方请求更大值时会被压到此上限。"
  },
  "health_check_timeout_seconds": {
    "description": "上游检测超时（秒）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 5,
      "max": 60,
      "step": 5
    },
    "hint": "检测请求不重试，也不会改变业务熔断计数。"
  },
  "skip_unhealthy_upstreams": {
    "description": "健康检查不通时跳过该上游",
    "type": "bool",
    "default": true,
    "hint": "检测明确失败的上游在有效期内会被跳过并写日志；不会删除上游。"
  },
  "health_skip_ttl_seconds": {
    "description": "健康检查结果有效期（秒）",
    "type": "int",
    "default": 21600,
    "hint": "超过有效期后不再据此跳过，避免过期结果误拦真实请求。"
  },
  "fallback_to_main_model": {
    "description": "真实调用失败后回退主模型",
    "type": "bool",
    "default": true,
    "hint": "只在上游真实调用失败时回退一次；健康检查跳过不算失败。"
  },
  "fallback_provider_id": {
    "description": "回退使用的 Provider ID",
    "type": "string",
    "default": "",
    "hint": "留空表示使用 AstrBot 当前默认主模型。"
  },
  "auto_bind_enabled": {
    "description": "自动绑定低风险后台任务",
    "type": "bool",
    "default": true,
    "hint": "仅处理内置白名单字段，不接管主对话、私聊、长期记忆、图片理解或工具调用。"
  },
  "auto_bind_require_ready_upstream": {
    "description": "有可用上游后才绑定",
    "type": "bool",
    "default": true,
    "hint": "建议保持开启，避免尚未填写 API 时中断后台任务。"
  },
  "auto_bind_only_empty": {
    "description": "仅绑定空白或默认字段",
    "type": "bool",
    "default": true,
    "hint": "开启后不会覆盖你手动指定的其他 Provider。"
  },
  "auto_bind_restore_on_disable": {
    "description": "关闭自动绑定时恢复旧值",
    "type": "bool",
    "default": true
  },
  "auto_bind_bilibili": {
    "description": "绑定 B站后台任务",
    "type": "bool",
    "default": true,
    "hint": "包括摘要、内容生成、候选预筛和日程计划；不包括评论、私信和主聊天。"
  },
  "auto_bind_memewiki": {
    "description": "绑定梗百科轻量门控",
    "type": "bool",
    "default": true,
    "hint": "只绑定是否需要查梗的轻量判断模型。"
  },
  "upstream_1": {
    "description": "上游 1",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用路由",
        "type": "bool",
        "default": false,
        "hint": "仅聊天、图转文、多模态可加入当前自动路由；关闭后不影响配置完整的聊天兼容 API 被直接指定。其他类型保存分类并按对应协议检测。"
      },
      "api_type": {
        "description": "API 类型",
        "type": "string",
        "default": "chat",
        "options": [
          "chat",
          "image_generation",
          "image_to_text",
          "embedding",
          "rerank",
          "stt",
          "tts",
          "asr",
          "multimodal"
        ],
        "hint": "chat=聊天，image_generation=文/图生图，image_to_text=图转文，multimodal=多模态。非聊天协议不会进入 Chat Completions 路由。"
      },
      "name": {
        "description": "名称",
        "type": "string",
        "default": "SiliconFlow"
      },
      "api_base": {
        "description": "API Base",
        "type": "string",
        "default": "https://api.siliconflow.cn/v1"
      },
      "api_key": {
        "description": "API Key",
        "type": "string",
        "default": ""
      },
      "model": {
        "description": "模型 ID",
        "type": "string",
        "default": "",
        "hint": "填写服务商模型列表中的完整 ID。"
      },
      "priority": {
        "description": "内部排序值",
        "type": "int",
        "default": 10,
        "hint": "插件页面会按拖拽顺序自动维护；一般不需要手动修改。数值越小越先使用。"
      },
      "supports_tools": {
        "description": "支持工具调用",
        "type": "bool",
        "default": true
      },
      "enable_thinking": {
        "description": "启用思考能力",
        "type": "bool",
        "default": false,
        "hint": "仅对支持 enable_thinking 的推理模型生效。默认关闭，关闭时请求体会携带 enable_thinking=false。"
      },
      "extra_body": {
        "description": "附加请求体参数（JSON 对象）",
        "type": "string",
        "default": "",
        "hint": "额外合并进请求 body 的 JSON，例如 {\"enable_thinking\": false} 可关掉推理模型的思维链（Qwen3 / 混元 / DeepSeek-R1 等），让它直接输出 JSON、秒回。留空则不发。"
      }
    }
  },
