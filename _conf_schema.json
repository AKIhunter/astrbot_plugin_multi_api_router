{
  "expose_plain_api_keys": {
    "description": "兼容旧行为：/upstreams/config 返回明文 API Key",
    "type": "bool",
    "default": false,
    "hint": "默认关闭。关闭时接口只回显掩码（如 sk-a1b2****cdef），明文需在页面点击「显示」，且会记录审计日志。仅在需要回退旧行为时临时开启。"
  },
  "enabled": {
    "description": "启用路由 Provider",
    "type": "bool",
    "default": true
  },
  "provider_id": {
    "description": "整体模式 Provider ID（固定为 multi_api_router，只读）",
    "type": "string",
    "default": "multi_api_router",
    "invisible": true,
    "hint": "已锁定：该 ID 是所有下游插件（BiliBot、AB 档案等）引用路由的固定标识，改名会让它们找不到 Provider。运行时强制使用 multi_api_router，此值仅展示。"
  },
  "request_timeout_seconds": {
    "description": "每个上游的请求超时（秒）",
    "type": "int",
    "default": 45,
    "slider": {
      "min": 5,
      "max": 600,
      "step": 5
    }
  },
  "route_timeout_seconds": {
    "description": "单次路由总超时限制（秒）",
    "type": "int",
    "default": 90,
    "slider": {
      "min": 5,
      "max": 600,
      "step": 5
    },
    "hint": "覆盖并发排队、上游重试、逐个上游尝试和主模型回退；达到总时限后停止后续调用。指定单个上游也受总时限约束。"
  },
  "max_attempts": {
    "description": "单次请求最多尝试几个上游",
    "type": "int",
    "default": 3,
    "slider": {
      "min": 1,
      "max": 5,
      "step": 1
    },
    "hint": "限制候选上游数量，不是同一上游的重试次数。所有尝试和重试等待共用总时限。"
  },
  "upstream_retry_count": {
    "description": "每个上游异常重试次数",
    "type": "int",
    "default": 1,
    "slider": {"min": 0, "max": 5, "step": 1},
    "hint": "首次调用不计入重试次数，0 表示不重试。仅 classify() 判为 retry_then_rotate 的错误（超时、连接、HTTP 408/429/5xx）原地重试；429 优先遵守 Retry-After。"
  },
  "retry_interval_seconds": {
    "description": "异常重试间隔（秒）",
    "type": "float",
    "default": 1.0,
    "hint": "范围 0–3600 秒，支持小数；只暂停本轮请求后再重试该上游，不冻结新请求。等待计入路由总时限。"
  },
  "max_concurrency": {
    "description": "路由器最大并发请求数",
    "type": "int",
    "default": 4,
    "slider": {
      "min": 1,
      "max": 32,
      "step": 1
    }
  },
  "max_input_chars": {
    "description": "单次请求最大文字输入字符数",
    "type": "int",
    "default": 262144,
    "hint": "统计文字、工具定义及工具结果，图片内容块的Base64另计体积。范围1000–2000000；不是模型Token上限。"
  },
  "max_image_bytes": {
    "description": "单张图片最大字节数",
    "type": "int",
    "default": 8388608,
    "hint": "内联/本地图片解码后最多8 MiB；可设置1024–67108864。远程URL不额外下载计量。"
  },
  "max_total_image_bytes": {
    "description": "单次请求图片合计最大字节数",
    "type": "int",
    "default": 33554432,
    "hint": "内联/本地图片合计默认32 MiB；范围1024–134217728。"
  },
  "max_image_count": {
    "description": "单次请求最多图片数",
    "type": "int",
    "default": 32,
    "hint": "包括当前、历史和工具结果中的图片，范围1–128。"
  },
  "history_image_compaction_enabled": {
    "description": "旧历史图片用观察和占位替代",
    "type": "bool",
    "default": true,
    "hint": "仅压缩发送副本，原始历史不改。保留最近2个历史用户轮次内最多4张原图，当前用户图片不裁剪。"
  },
  "max_output_tokens": {
    "description": "单次请求最大输出 Token",
    "type": "int",
    "default": 2048,
    "hint": "调用方请求更大值时会被压到此上限。"
  },
  "health_check_timeout_seconds": {
    "description": "上游检测超时（秒）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 5,
      "max": 60,
      "step": 5
    },
    "hint": "检测请求不重试，也不会改变真实调用的失败统计。"
  },
  "skip_unhealthy_upstreams": {
    "description": "自动路由跳过已确认的配置错误",
    "type": "bool",
    "default": true,
    "hint": "检测确认的认证、权限、路径或额度错误（HTTP 401/402/403/404）在有效期内会被跳过并写日志；不会删除上游。"
  },
  "health_skip_ttl_seconds": {
    "description": "健康检查结果有效期（秒）",
    "type": "int",
    "default": 21600,
    "hint": "超过有效期后不再据此跳过，避免过期结果误拦真实请求。"
  },
  "fallback_to_main_model": {
    "description": "真实调用失败后回退主模型",
    "type": "bool",
    "default": true,
    "hint": "只在上游真实调用失败时回退一次；健康检查跳过不算失败。"
  },
  "fallback_provider_id": {
    "description": "回退使用的 Provider ID",
    "type": "string",
    "default": "",
    "hint": "留空表示使用 AstrBot 当前默认主模型。"
  },
  "auto_bind_enabled": {
    "description": "自动绑定低风险后台任务",
    "type": "bool",
    "default": true,
    "hint": "仅处理内置白名单字段，不接管主对话、私聊、长期记忆、图片理解或工具调用。"
  },
  "auto_bind_require_ready_upstream": {
    "description": "有可用上游后才绑定",
    "type": "bool",
    "default": true,
    "hint": "建议保持开启，避免尚未填写 API 时中断后台任务。"
  },
  "auto_bind_only_empty": {
    "description": "仅绑定空白或默认字段",
    "type": "bool",
    "default": true,
    "hint": "开启后不会覆盖你手动指定的其他 Provider。"
  },
  "auto_bind_restore_on_disable": {
    "description": "关闭自动绑定时恢复旧值",
    "type": "bool",
    "default": true
  },
  "auto_bind_bilibili": {
    "description": "绑定 B站后台任务",
    "type": "bool",
    "default": true,
    "hint": "包括摘要、内容生成、候选预筛和日程计划；不包括评论、私信和主聊天。"
  },
  "auto_bind_memewiki": {
    "description": "绑定梗百科轻量门控",
    "type": "bool",
    "default": true,
    "hint": "只绑定是否需要查梗的轻量判断模型。"
  },
  "upstream_1": {
    "description": "上游 1",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用路由",
        "type": "bool",
        "default": false,
        "hint": "仅聊天、图转文、多模态可加入当前自动路由；关闭后不影响配置完整的聊天兼容 API 被直接指定。其他类型保存分类并按对应协议检测。"
      },
      "api_type": {
        "description": "API 类型",
        "type": "string",
        "default": "chat",
        "options": [
          "chat",
          "image_generation",
          "image_to_text",
          "embedding",
          "rerank",
          "stt",
          "tts",
          "asr",
          "multimodal"
        ],
        "hint": "chat=聊天，image_generation=文/图生图，image_to_text=图转文，multimodal=多模态。非聊天协议不会进入 Chat Completions 路由。"
      },
      "name": {
        "description": "名称",
        "type": "string",
        "default": "SiliconFlow"
      },
      "api_base": {
        "description": "API Base",
        "type": "string",
        "default": "https://api.siliconflow.cn/v1"
      },
      "api_key": {
        "description": "API Key",
        "type": "string",
        "default": ""
      },
      "model": {
        "description": "模型 ID",
        "type": "string",
        "default": "",
        "hint": "填写服务商模型列表中的完整 ID。"
      },
      "priority": {
        "description": "内部排序值",
        "type": "int",
        "default": 10,
        "hint": "插件页面会按拖拽顺序自动维护；一般不需要手动修改。数值越小越先使用。"
      },
      "supports_tools": {
        "description": "支持工具调用",
        "type": "bool",
        "default": true
      },
      "enable_thinking": {
        "description": "启用思考能力",
        "type": "bool",
        "default": false,
        "hint": "仅对支持 enable_thinking 的推理模型生效。默认关闭，关闭时请求体会携带 enable_thinking=false。"
      },
      "extra_body": {
        "description": "附加请求体参数（JSON 对象）",
        "type": "string",
        "default": "",
        "hint": "额外合并进请求 body 的 JSON，例如 {\"enable_thinking\": false} 可关掉推理模型的思维链（Qwen3 / 混元 / DeepSeek-R1 等），让它直接输出 JSON、秒回。留空则不发。"
      }
    }
  },
